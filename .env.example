# Copy this file to .env.local and replace the placeholders with your local settings.
APP_BUNDLE_ID=com.yourcompany.yourapp

# Optional: leave empty for unsigned builds, or set your installed signing identity.
# Example: "Developer ID Application: Your Name (TEAMID)"
MAC_SIGNING_IDENTITY=

# Google Cloud OAuth client ID with application type Desktop app.
GOOGLE_CLIENT_ID=

# Google-issued Desktop app client secret; never use a web/server client secret.
GOOGLE_CLIENT_SECRET=

# Microsoft Entra application (client) ID for a public desktop app; no secret required.
MICROSOFT_CLIENT_ID=

# Match the registration audience: consumers (personal), organizations (work/school), or common (both).
MICROSOFT_TENANT_ID=common

# Public Dropbox app key for a scoped app with public-client PKCE enabled.
DROPBOX_APP_KEY=

# Exact redirect registered in the Dropbox App Console; use an unused fixed loopback port.
DROPBOX_REDIRECT_URI=http://127.0.0.1:53683/dropbox-callback
