# Copy this file to .env.local and replace the placeholders with your local settings.
APP_BUNDLE_ID=com.yourcompany.yourapp

# Optional: leave empty for unsigned builds, or set your installed signing identity.
# Example: "Developer ID Application: Your Name (TEAMID)"
MAC_SIGNING_IDENTITY=

# Google Cloud OAuth client ID with application type Desktop app.
GOOGLE_CLIENT_ID=

# Google-issued Desktop app client secret; never use a web/server client secret.
GOOGLE_CLIENT_SECRET=
